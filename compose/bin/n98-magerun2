#!/usr/bin/env bash
if ! bin/cliq ls bin/n98-magerun2.phar; then
  echo "Downloading n98-magerun2.phar, just a moment..." >&2
  bin/clinotty curl -sS -O https://files.magerun.net/n98-magerun2.phar
  bin/clinotty curl -sS -o n98-magerun2.phar.sha256 https://files.magerun.net/sha256.php?file=n98-magerun2.phar
  bin/clinotty shasum -a 256 -c n98-magerun2.phar.sha256
  [ $? != 0 ] && echo "sha256 checksum do not match!" >&2 && exit

  bin/cliq chmod +x n98-magerun2.phar
  bin/cliq mkdir -p bin
  bin/cliq mv n98-magerun2.phar bin

  # copie du fichier phar dans les fichiers sources Windows car nécessaire pour mapping chemins pendant session xdebug
  bin/copyfromcontainer bin/n98-magerun2.phar
fi

# on désactive l'importation des core commandes car bin/magento list dysfonctionne avec paramètre XDEBUG_TRIGGER
bin/cli bin/n98-magerun2.phar --root-dir=/var/www/html --skip-core-commands "$@"
