#!/usr/bin/env bash
bin/cli composer "$@"

if [ $? -eq 0 ]; then
  if [[ "$1" == "install" || "$1" == "update" || "$1" == "require" || "$1" == "up" || "$1" == "prl" || "$1" == "prp" ]]; then
    bin/copyfromcontainer composer.json
    bin/copyfromcontainer composer.lock
    bin/copyfromcontainer patches.json
    bin/copyfromcontainer patches.lock.json
  fi
fi
