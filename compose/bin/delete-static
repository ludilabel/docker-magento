#!/usr/bin/env bash

source env/dev-setup-config.env

if [ -z "$PROD_IP" ] || [ -z "$PROD_USER" ] || [ -z "$PROD_MEDIA_PATH" ] || [ -z "$PROD_DEBIAN_RSA_PATH" ]; then
  return
fi

DOCKER_SERVICE="phpfpm"
CONTAINER_ID=$(bin/docker-compose ps -q $DOCKER_SERVICE | awk '{print $1}')

docker exec "$CONTAINER_ID" rm -rf /var/www/html/pub/static/adminhtml/
docker exec "$CONTAINER_ID" rm -rf /var/www/html/pub/static/frontend/
docker exec "$CONTAINER_ID" rm -rf /var/www/html/pub/static/deployed_version.txt
docker exec "$CONTAINER_ID" rm -rf /var/www/html/var/view_preprocessed/pub/static/
echo "Deleting static files...OK"
