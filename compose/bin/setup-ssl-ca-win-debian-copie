#!/usr/bin/env bash
set -o errexit

source bin/wsl-fn

# Debian
echo "Installation de l'autorité de certifications sur la Debian"
echo "Pour pouvoir jouer depuis le shell Debian des commandes CURLs sur le site Magento local"

echo "Recopie du fichier rootCA.pem dans la Debian"
sudo mkdir -p /usr/local/share/ca-certificates/docker-magento/
sudo docker cp "$(bin/docker-compose ps -q app|awk '{print $1}')":/root/.local/share/mkcert/rootCA.pem /usr/local/share/ca-certificates/docker-magento/rootCA.crt
sudo update-ca-certificates

# Windows
echo "Veuillez coller un chemin Windows quelconque où retrouver le fichier rootCA.crt (version Windows) à installer"
read -r -p "(ex : D:\projets\Magento2\nginx) : " destination_win_path

wsl_destination_win_path=$(convertWinPathToWslPath "$destination_win_path")

# Vérifier si le chemin existe
if [ ! -d "$wsl_destination_win_path" ]; then
    echo "Le chemin spécifié n'existe pas."
    exit 1
fi


echo "conversion du rootCA.pem en rootCA.crt pour Windows"
docker cp "$(bin/docker-compose ps -q app|awk '{print $1}')":/root/.local/share/mkcert/rootCA.pem .
openssl x509 -outform der -in rootCA.pem -out rootCA.crt
rsync -av --delete "rootCA.crt" "$wsl_destination_win_path"
rm rootCA.pem rootCA.crt

echo "Le fichier a été téléchargé dans le dossier Windows."
echo "Double cliquer sur le fichier pour installer l'autorité de certification."
echo "Lire la documentation du projet si vous ne savez pas comment installer une autorité de certification."
