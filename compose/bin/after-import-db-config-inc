#!/usr/bin/env bash

set -o errexit

source bin/terminal-colors

 # Toutes les commandes à jouer lorsqu'on change de base de données
green "Exécution de toutes les commandes bin/* qui sont nécessaires après un changement de base de données"
echo "Importation des données app/etc/config.php et app/etc/env.php en BDD"
bin/magento app:config:import

# Application des URLs boutiques de l'environnement docker-magento
echo "$(green "Running bin/setup-domain...")"
bin/setup-domain

# Configuration pour que Elasticsearch 8 d’Amasty parle avec le serveur Elasticsearch de Docker
bin/magento config:set catalog/search/elasticsearch7_server_hostname elasticsearch
bin/magento config:set amasty_elastic/connection/server_hostname elasticsearch

# On veut utiliser le Labelmaker 2 de Recette dans l'environnement Docker
# labelmaker/url/domain
bin/mysql -e "
  UPDATE core_config_data
  SET value = REPLACE(value, 'rc', 'recette.dev')
  WHERE path = 'labelmaker/url/domain';
"

# labelmaker/api/domain
bin/mysql -e "
  UPDATE core_config_data
  SET value = REPLACE(value, 'rc', 'recette.dev')
  WHERE path = 'labelmaker/api/domain';
"
# Désactivation du module Ludilabel_Shippingbo
bin/magento config:set shippingbo/api/enabled 0

# Désactivation du module zero-downtime
bin/magento config:set mfzerodwt/general/enabled 0

# Désactivation du full page cache varnish
bin/magento config:set system/full_page_cache/caching_application 1

# Désactivation par défaut du merge et minify css
bin/magento config:set dev/css/merge_css_files 0
bin/magento config:set dev/css/minify_files 0

# Désactivation par défaut de certains caches pour l'environnement de dev
bin/magento cache:disable full_page block_html

# Désactivation par défaut de smtp Brevo et activation de mailcatcher pour intercepter les e-mails transactionnels
bin/mailcatcher enable

if [ "$USAGE_MODE" != "install" ]; then
  bin/clinotty bin/magento setup:upgrade
  bin/clinotty bin/magento setup:di:compile
  bin/clinotty bin/magento cache:flush
fi

green "Toutes les commandes bin/* ont été exécutées."
