#!/usr/bin/env bash
# v1 : import de /media du serveur prod
#

source env/dev-setup-config.env
source bin/setup-ssh-fn

if [ -z "$PROD_IP" ] || [ -z "$PROD_USER" ] || [ -z "$PROD_MEDIA_PATH" ] || [ -z "$PROD_DEBIAN_RSA_PATH" ]; then
  bin/setup-prod
  source env/dev-setup-config.env # Mise à jour des variables d’environnement
fi

DOCKER_SERVICE="phpfpm"
CONTAINER_ID=$(bin/docker-compose ps -q $DOCKER_SERVICE | awk '{print $1}')

# bin/setup-ssh-fn
run_ssh_agent_and_register_key "$PROD_DEBIAN_RSA_PATH"

# Ensure the parent destination path exists
mkdir -p "$TRANSFER_PATH/prod/pub"


echo "Téléchargement des fichiers /media de prod sur la Debian WSL2 (long...)"
rsync -az --info=progress2 --delete -e "ssh" $PROD_USER@$PROD_IP:$PROD_MEDIA_PATH "$TRANSFER_PATH/prod/pub"

echo "Copie des fichiers Debian dans le service Docker (long...)"
docker exec "$CONTAINER_ID" rm -rf /var/www/html/pub/media
docker cp "$TRANSFER_PATH/prod/pub/media/." "$CONTAINER_ID:/var/www/html/pub/media"

echo "Running bin/fixowns..."
bin/fixowns

echo "Running bin/fixperms..."
bin/fixperms