#!/usr/bin/env bash
set -o errexit

# Arguments:
# $1 : (Optionnel) sql_file : Chemin vers un fichier SQL sur Windows à importer.

source env/dev-setup-config.env
source bin/import-db-fn

# Si un chemin vers un fichier sql Windows est fourni, on l'importe
if [ "$1" ]; then
  sql_file="$1"
  if [[ "$sql_file" == *.sql ]]; then
    import_from_windows "$sql_file"
  else
    echo "Erreur : Le fichier $sql_file fourni ne termine pas par .sql."
    exit 1
  fi

else
  # Sinon on donne le choix au développeur
  echo ""
  echo "Quelle base de données souhaitez-vous importer ?"
  echo "1) Depuis le fichier backup de prod"
  echo "2) Depuis un des fichiers backup .sql qui transitent par la Debian"
  echo "3) Depuis un fichier backup .sql dans Windows"
  read -r -p "Entrez votre choix [1, 2 ou 3] : " choice

  case $choice in
    1)
      import_from_prod
      ;;
    2)
      import_from_debian
      ;;
    3)
      import_from_windows
      ;;
  esac
fi

if [ $? -ne 0 ]; then
    echo "Erreur lors de l'importation de la base de données"
    exit 1
fi

# Configuration de la base de données
if [ "$USAGE_MODE" != "install" ]; then
  source bin/after-import-db-config-inc
fi