#!/usr/bin/env bash

PS3="Choisissez une fonctionnalité à réparer : "
options=("1 - xdebug" "2 - connexion à github" "3 - connexion au serveur recette" "4 - connexion au serveur preprod" "5 - connexion au serveur prod" "Entrée pour quitter")

select opt in "${options[@]}"
do
  case $REPLY in
        1)
            echo "Hypothèse : L’ordinateur s'est connecté à un nouveau réseau LAN et son IP local a changé"
            echo "Solution : redéfinir la résolution DNS pour que le service Docker phpfpm puisse communiquer avec la nouvelle adresse IP de Windows"
            echo "Running bin/setup-host-docker-win"
            bin/setup-host-docker-win

            break
            ;;
        2)
            echo "Hypothèse : vous vous êtes trompé de compte utilisateur ou vous avez besoin de régénérer une nouvelle clé"
            echo "Solution : saisi du compte utilisateur et régénération de la clé SSH"
            read -r -p "email du compte utilisateur Github : " github_user
            bin/setup-github-ssh github_user "regenerate-key"

            break
            ;;
        3)
            echo "Hypothèse : vous avez renseigné des informations erronées"
            echo "Solution : resaisir toutes les informations"
            read -r -p "serveur IP : " recette_ip
            read -r -p "serveur chemin absolu dossier racine : " recette_bin_path
            read -r -p "serveur chemin absolu dossier media : " recette_media_path
            bin/setup-recette-server "$recette_ip" "$recette_bin_path" "$recette_media_path"

            read -r -p "utilisateur BDD : " recette_db_user
            read -r -p "Nom BDD : " recette_db_name
            read -r -p "Mot de passe BDD : " recette_db_pass
            bin/setup-recette-db "$recette_db_user" "$recette_db_name" "$recette_db_pass"

            read -r -p "serveur utilisateur SSH : " recette_user
            read -r -p "chemin Windows qui contient clé id_rsa (OpenSSH) pour connexion SSH : " win_id_rsa_path
            bin/setup-recette-ssh "$recette_user" "$win_id_rsa_path"

            break
            ;;
        4)
            echo "Hypothèse : vous avez renseigné des informations erronées"
            echo "Solution : resaisir toutes les informations"
            read -r -p "serveur IP : " preprod_ip
            read -r -p "serveur chemin absolu dossier racine : " preprod_bin_path
            read -r -p "serveur chemin absolu dossier media : " preprod_media_path
            bin/setup-preprod-server "$preprod_ip" "$preprod_bin_path" "$preprod_media_path"

            read -r -p "utilisateur BDD : " preprod_db_user
            read -r -p "Nom BDD : " preprod_db_name
            read -r -p "Mot de passe BDD : " preprod_db_pass
            bin/setup-preprod-db "$preprod_db_user" "$preprod_db_name" "$preprod_db_pass"

            read -r -p "serveur utilisateur SSH : " preprod_user
            read -r -p "chemin Windows qui contient clé id_rsa (OpenSSH) pour connexion SSH : " win_id_rsa_path
            bin/setup-preprod-ssh "$preprod_user" "$win_id_rsa_path"

            break
            ;;
        5)
            echo "Hypothèse : vous avez renseigné des informations erronées"
            echo "Solution : resaisir toutes les informations"
            read -r -p "serveur IP : " prod_ip
            read -r -p "serveur chemin absolu dossier racine : " prod_bin_path
            read -r -p "serveur chemin absolu dossier media : " prod_media_path
            bin/setup-prod-server "$prod_ip" "$prod_bin_path" "$prod_media_path"

            read -r -p "utilisateur BDD : " prod_db_user
            read -r -p "Nom BDD : " prod_db_name
            read -r -p "Mot de passe BDD : " prod_db_pass
            bin/setup-prod-db "$prod_db_user" "$prod_db_name" "$prod_db_pass"

            read -r -p "serveur utilisateur SSH : " prod_user
            read -r -p "chemin Windows qui contient clé id_rsa (OpenSSH) pour connexion SSH : " win_id_rsa_path
            bin/setup-prod-ssh "$prod_user" "$win_id_rsa_path"

            break
            ;;
        "")
            echo "Sortie..."
            break
            ;;
        *)
            echo "Saisie invalide"
            ;;
    esac
done