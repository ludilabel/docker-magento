#!/usr/bin/env bash
set -o errexit

# Arguments:
# $1 : (Optionnel) : destination d'exportation
# $2 : (Optionnel|Requirement: $1="windows") :  Chemin Windows où déposer le fichier backup.

source bin/wsl-fn
source bin/export-db-fn

# If an argument is passed, use it and don't open menu
if [ "$1" == "windows" ]; then
    export_windows_file "$2"
elif [ "$1" == "recette" ]; then
    export_replace_recette
else

  # Menu pour choisir l'action
  echo ""
  echo "Que souhaitez-vous faire ?"
  echo "1) Exporter base Docker vers un fichier de backup sur Windows"
  echo "2) Exporter base Docker et l'importer dans base Recette"
  read -r -p "Entrez votre choix [1 ou 2] : " choice

  case $choice in
    1)
      export_windows_file "$2"
      ;;

    2)
      export_replace_recette
      ;;

    *)
      echo "Choix invalide. Veuillez entrer 1 ou 2."
      exit 1
      ;;
  esac

fi